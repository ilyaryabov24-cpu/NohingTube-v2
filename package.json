{
  "name": "nothingtube",
  "version": "1.0.0",
  "description": "Минималистичный клон YouTube в стиле Nothing. SPA на HTML/CSS/JS + GitHub REST API backend + Capacitor для сборки APK.",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "serve": "npx serve .",
    "android": "npx cap sync android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
